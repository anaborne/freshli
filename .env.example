# Copy to .env.local and fill in. .env.local is gitignored. Never commit real values.
#
# Supabase project URL and anon (publishable) key. The project this app ran
# against has been deleted, so these have to point at your own. The anon key is
# designed to be sent to the browser, so it is only as safe as the row-level
# security policies on the table it can reach. Enable RLS on `ingredients`
# before pointing a public deployment at a project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. Needs access to gpt-4o (vision), gpt-3.5-turbo and dall-e-2.
OPENAI_API_KEY=sk-your-key
